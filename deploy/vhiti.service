[Unit]
Description=Войти в IT Flask application
After=network.target mariadb.service

[Service]
Type=simple
User=vhiti
Group=vhiti
WorkingDirectory=/opt/vhiti
EnvironmentFile=/etc/vhiti/vhiti.env
ExecStart=/opt/vhiti/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - wsgi:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/vhiti/instance

[Install]
WantedBy=multi-user.target
